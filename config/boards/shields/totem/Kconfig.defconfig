if SHIELD_TOTEM_CENTRAL_SNAKE

if ZMK_BACKLIGHT

config PWM
    default y

config LED_PWM
    default y

endif # ZMK_BACKLIGHT

config ZMK_KEYBOARD_NAME
    default "TOTEMX LP"

config ZMK_SPLIT_ROLE_CENTRAL
    default y

choice ZMK_DISPLAY_STATUS_SCREEN
    default ZMK_DISPLAY_STATUS_SCREEN_CUSTOM
endchoice

config ZMK_DISPLAY_STATUS_SCREEN_CUSTOM
    select ZMK_WPM
    imply ZMK_HID_INDICATORS

choice ZMK_DISPLAY_WORK_QUEUE
    default ZMK_DISPLAY_WORK_QUEUE_DEDICATED
endchoice

config LV_Z_VDB_SIZE
	default 64
    
config LV_DPI_DEF
    default 148

config LV_Z_BITS_PER_PIXEL
    default 16

choice ST7789V_PIXEL_FORMAT
    default ST7789V_RGB565
endchoice

choice LV_COLOR_DEPTH
    default LV_COLOR_DEPTH_16
endchoice

endif

if SHIELD_TOTEM_CENTRAL_PROSPECTOR

if ZMK_BACKLIGHT

config PWM
    default y

config LED_PWM
    default y

endif # ZMK_BACKLIGHT

config ZMK_KEYBOARD_NAME
    default "TOTEMX LP"
    
config ZMK_SPLIT_ROLE_CENTRAL
    default y

config ZMK_USB
    default y

endif

if SHIELD_TOTEM_CENTRAL_DONGLE || SHIELD_TOTEM_CENTRAL_LEFT || SHIELD_TOTEM_ESP32_DONGLE

config ZMK_KEYBOARD_NAME
    default "TOTEMX LP"

config ZMK_SPLIT_ROLE_CENTRAL
    default y

endif

if ZMK_DISPLAY

config SSD1306
    default y

choice ZMK_DISPLAY_WORK_QUEUE
    default ZMK_DISPLAY_WORK_QUEUE_DEDICATED
endchoice

endif

if LVGL

config LV_Z_VDB_SIZE
    default 64

config LV_DPI_DEF
    default 148

config LV_Z_BITS_PER_PIXEL
    default 1

choice LV_COLOR_DEPTH
    default LV_COLOR_DEPTH_1
endchoice

endif

if SHIELD_TOTEM_CENTRAL_DONGLE || SHIELD_TOTEM_CENTRAL_LEFT || SHIELD_TOTEM_PERIPHERAL_LEFT || SHIELD_TOTEM_PERIPHERAL_RIGHT || SHIELD_TOTEM_CENTRAL_SNAKE || SHIELD_TOTEM_CENTRAL_PROSPECTOR || SHIELD_TOTEM_ESP32_DONGLE

config ZMK_SPLIT
    default y

config ZMK_BLE
    default y

config ZMK_POINTING
    default y

endif

if SHIELD_TOTEM_CENTRAL_LEFT || SHIELD_TOTEM_PERIPHERAL_LEFT

config I2C
    default y

endif
